<!-- ============================ DEPRECATED — DO NOT USE ====================
  SECURITY: this agent runs /Applications/FLOW.app's Mach-O (an ad-hoc-signed
  app that was granted Full Disk Access) which exec's a USER-WRITABLE script —
  a TCC-bypass bridge. FLOW.app and its FDA grant have been removed and
  scripts/install_launch_agent.sh refuses to install this. The active,
  permission-free worker is com.flows.worker -> /Users/Shared/flows/worker.sh
  (FANS pattern). Kept only as a record of the abandoned FDA approach.
  ======================================================================= -->
<!--
  FLOWS continuous test runner — macOS LaunchAgent.

  Makes the local worker survive sleep, shutdown, reboot, and crash:
    * RunAtLoad          — starts on login / boot (survives shutdown+reboot).
    * KeepAlive/SuccessfulExit=false — relaunches ONLY on crash/non-zero exit,
      so a deliberate clean stop (tests/.stop_runner -> exit 0) stays stopped,
      but a SIGKILL / panic / OOM-kill is auto-restarted (resume).
    * ThrottleInterval   — 30 s floor between relaunches so a crash-loop can't
      hammer the machine.
    * ProcessType=Background + low Nice — yields CPU to the user's foreground
      work; the runner's own memory governor holds the 90% ceiling.

  On wake from sleep the process is resumed by the OS; if the machine crashed
  during sleep, the next boot's RunAtLoad restarts it. Combined with the
  runner's pass-in-progress marker + JSONL tail-repair, an interrupted pass is
  discarded and redone from the last SUCCESSFUL result — never a partial.

  __PLACEHOLDERS__ are substituted by scripts/install_launch_agent.sh.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flows.testrunner</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Run FLOW.app's compiled Mach-O executable DIRECTLY (not via
             /bin/bash) so TCC attributes file access to FLOW.app's identity,
             which holds Full Disk Access. The binary spawns the runner as a
             child and stays alive as its responsible parent. -->
        <string>/Applications/FLOW.app/Contents/MacOS/FLOW</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/data/results/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/data/results/launchd_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>FLOWS_MEM_CEILING_PCT</key>
        <string>90</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
