# R session / project state
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Local environment / secrets — never commit
.Renviron

# macOS
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Build-time inputs not needed at runtime
data/reference/geofabrik_wisconsin-latest.osm.pbf
*.pbf

# Runtime caches (regenerable, not for version control)
data/runtime_cache/

# Autonomous test runner artifacts (regenerable, high-churn)
tests/continuous_results.jsonl
tests/.runner_heartbeat
tests/.runner.log
tests/.stop_runner
tests/.runner.pid
tests/.runner_stdout.log

# Durable autonomous results (persistent, crash-safe, high-churn).
# Glob (not bare directory) so the negation below works — git does not
# descend into a fully-ignored directory, which silently hid the
# hand-authored scientific log from version control.
data/results/*
# experiments.jsonl is AUTHORED history (the scientific-method log), not a
# regenerable artifact — it must stay trackable.
!data/results/experiments.jsonl

# Rust build artifacts
rust/target/

# Transit feeds + built .ftt shards (large; per-feed redistribution licenses
# vary — see docs/TRANSIT_ROUTING.md licensing notes). Fetch with
# scripts/fetch_gtfs.sh, build with scripts/build_ftt.sh.
data/transit/

# Apple app: generated project + build products (project.yml is the source
# of truth — regenerate with `cd apple && xcodegen generate`)
apple/FLOWS.xcodeproj/
apple/FLOWS/Generated/
apple/build/
apple/DerivedData/

# Session-local tool state: any hidden directory at the repo root except
# .github (CI config, tracked). Editors and dev tools drop scratch dirs
# here; none of it belongs in history.
/.*/
!/.github/

# App risk bundle copies are generated (rust national-bundle + history-baseline)
apple/FLOWS/Resources/app_risk_bundle.json

# Re-downloadable reference data (Census gazetteer, scrape backups)
data/reference/
data/runtime_cache/app_risk_bundle.wi_only.json

# Offline POI shards built from the FSQ OS Places TSV (regenerable:
# scripts/build_places_shards.sh). Glob + negation so the Apache-2.0
# attribution NOTICE stays tracked (git does not descend into a fully
# ignored directory — same trap as data/results above).
data/places/*
!data/places/ATTRIBUTION.txt

# 20-year history pipeline artifacts (regenerable: scripts/build_history_baseline.sh)
data/runtime_cache/history_dense.bin
data/runtime_cache/history_harmonic.bin
data/runtime_cache/history_training_rows.csv
data/runtime_cache/app_risk_bundle.pre_history.json
data/runtime_cache/history_route_head.json
